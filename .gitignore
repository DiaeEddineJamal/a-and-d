# dependencies
node_modules/

# Build output. The hashed bundle and index.html ARE committed: a free host
# installs production dependencies only, so vite is not there to build with,
# and a 512MB container should not be running rollup on every wake either.
# Everything vite copies in from public/ stays out of git - the server serves
# public/ directly, and Vercel / Pages run their own build.
racing-game/dist/*
!racing-game/dist/index.html
racing-game/dist/assets/*
!racing-game/dist/assets/
!racing-game/dist/assets/index-*.js
!racing-game/dist/assets/index-*.css

# local env / secrets
.env
.env.*

# tooling
.vite/
*.log
.DS_Store

# test artefacts (tools/browser-check.mjs, tools/mobile-check.mjs)
shots/
shots-mobile/
shots-look/

# local editor tooling state
.cursor/

# Next.js build output and agent tooling state
.next/
.omc/
